;;; term-lisp prelude (Plan 1 MVP)

;; Booleans
(datatype Bool (True) (False))
(define true True)
(define false False)

(define (if (True) a b) a)
(define (if (False) a b) b)
(define (not (True)) (False))
(define (not (False)) (True))
(define (and (True) (True)) (True))
(define (and (True) (False)) (False))
(define (and (False) a) (False))
(define (or (True) a) (True))
(define (or (False) (True)) (True))
(define (or (False) (False)) (False))

;; Pairs
(datatype Pair (Pair a b))
(define (cons a b) (Pair a b))
(define (car (Pair a b)) a)
(define (cdr (Pair a b)) b)

;; Peano naturals
(datatype Nat (Zero) (Succ Nat))
(define zero Zero)
(define one (Succ Zero))
(define two (Succ (Succ Zero)))
(define (plus Zero b) b)
(define (plus (Succ a) b) (Succ (plus a b)))

;; Higher-order: apply a passed function to one argument
(define (map a (:lambda fun)) (fun a))

;; Monads (phase B: explicit dictionaries)

(datatype MonadDict (MonadDict tb tr tf))
(datatype Maybe (Nothing) (Just a))
(datatype List (Nil) (Cons a (List a)))

(define (monad-return (MonadDict bind return fmap) v) (return v))
(define (monad-bind (MonadDict bind return fmap) m k) (bind m k))
(define (monad-fmap (MonadDict bind return fmap) f m) (fmap f m))

;; Maybe instance
(define (maybe-return v) (Just v))
(define (maybe-bind Nothing k) Nothing)
(define (maybe-bind (Just v) k) (k v))
(define (maybe-fmap f Nothing) Nothing)
(define (maybe-fmap f (Just v)) (Just (f v)))
(define MaybeDict (MonadDict maybe-bind maybe-return maybe-fmap))

;; List instance
(define (list-return v) (Cons v Nil))
(define (list-append Nil ys) ys)
(define (list-append (Cons x xs) ys) (Cons x (list-append xs ys)))
(define (list-bind Nil k) Nil)
(define (list-bind (Cons x xs) k) (list-append (k x) (list-bind xs k)))
(define (list-fmap f Nil) Nil)
(define (list-fmap f (Cons x xs)) (Cons (f x) (list-fmap f xs)))
(define ListDict (MonadDict list-bind list-return list-fmap))

;; State instance: a computation is a function s -> (Pair a s)
(datatype Unit (Unit))
(define (state-return v) (lambda (s) (Pair v s)))
(define (state-bind-step (Pair a s2) k) ((k a) s2))
(define (state-bind m k) (lambda (s) (state-bind-step (m s) k)))
(define (state-fmap-step (Pair a s2) f) (Pair (f a) s2))
(define (state-fmap f m) (lambda (s) (state-fmap-step (m s) f)))
(define StateDict (MonadDict state-bind state-return state-fmap))
(define (state-get) (lambda (s) (Pair s s)))
(define (state-put v) (lambda (s) (Pair Unit v)))
(define run-state (lambda (m) m))

;; Reader instance: a computation is a function r -> a
(define (reader-return v) (lambda (r) v))
(define (reader-bind m k) (lambda (r) ((k (m r)) r)))
(define (reader-fmap f m) (lambda (r) (f (m r))))
(define ReaderDict (MonadDict reader-bind reader-return reader-fmap))
(define (reader-ask) (lambda (r) r))
(define run-reader (lambda (m) m))

;; Type classes (Plan 4: dictionary-passing elaboration)
;;
;; A dictionary is one record per class.  The generic methods below take
;; the dictionary as an extra first argument; the elaborator inserts it
;; automatically at each overloaded call site.  The `monad-*' accessors
;; above keep working unchanged (they receive the dictionary explicitly).

(datatype FunctorDict (FunctorDict fmap))
(datatype ApplicativeDict (ApplicativeDict pure ap))

(class Functor (f) nil
  (fmap ((-> a b) -> (f a) -> (f b))))
(class Applicative (f) nil
  (pure (a -> (f a)))
  (ap ((f (-> a b)) -> (f a) -> (f b))))
(class Monad (m) nil
  (bind ((m a) -> (-> a (m b)) -> (m b)))
  (return (a -> (m a))))

(define (fmap (FunctorDict impl) g x) (impl g x))
(define (bind (MonadDict b r f) m k) (b m k))
(define (return (MonadDict b r f) x) (r x))
(define (pure (ApplicativeDict p a) x) (p x))
(define (ap (ApplicativeDict p a) mf mx) (a mf mx))

(define FunctorMaybeDict (FunctorDict maybe-fmap))
(define FunctorListDict (FunctorDict list-fmap))
(define FunctorStateDict (FunctorDict state-fmap))
(define FunctorReaderDict (FunctorDict reader-fmap))

;; Applicative instance implementations
(define (maybe-pure x) (Just x))
(define (maybe-ap Nothing _) Nothing)
(define (maybe-ap (Just f) Nothing) Nothing)
(define (maybe-ap (Just f) (Just x)) (Just (f x)))

(define (list-pure x) (Cons x Nil))
(define (list-ap Nil _) Nil)
(define (list-ap (Cons f fs) xs)
  (list-append (list-fmap f xs) (list-ap fs xs)))

(define (state-pure v) (lambda (s) (Pair v s)))
(define (state-ap mf mx) (lambda (s) (state-ap-run (mf s) mx)))
(define (state-ap-run (Pair f s1) mx) (state-ap-run2 f (mx s1)))
(define (state-ap-run2 f (Pair x s2)) (Pair (f x) s2))

(define (reader-pure v) (lambda (r) v))
(define (reader-ap mf mx) (lambda (r) ((mf r) (mx r))))

(define ApplicativeMaybeDict (ApplicativeDict maybe-pure maybe-ap))
(define ApplicativeListDict (ApplicativeDict list-pure list-ap))
(define ApplicativeStateDict (ApplicativeDict state-pure state-ap))
(define ApplicativeReaderDict (ApplicativeDict reader-pure reader-ap))

(instance (Functor Maybe) FunctorMaybeDict)
(instance (Functor List) FunctorListDict)
(instance (Functor State) FunctorStateDict)
(instance (Functor Reader) FunctorReaderDict)
(instance (Applicative Maybe) ApplicativeMaybeDict)
(instance (Applicative List) ApplicativeListDict)
(instance (Applicative State) ApplicativeStateDict)
(instance (Applicative Reader) ApplicativeReaderDict)
(instance (Monad Maybe) MaybeDict)
(instance (Monad List) ListDict)
(instance (Monad State) StateDict)
(instance (Monad Reader) ReaderDict)

;; List library
(define (head (Cons x xs)) x)
(define (tail (Cons x xs)) xs)
(define (length Nil) 0)
(define (length (Cons x xs)) (+ 1 (length xs)))
(define (append Nil ys) ys)
(define (append (Cons x xs) ys) (Cons x (append xs ys)))
(define (map-list f Nil) Nil)
(define (map-list f (Cons x xs)) (Cons (f x) (map-list f xs)))
(define (filter f Nil) Nil)
(define (filter f (Cons x xs)) (if (f x) (Cons x (filter f xs)) (filter f xs)))
(define (foldr f z Nil) z)
(define (foldr f z (Cons x xs)) (f x (foldr f z xs)))

;; Assertions
(define (assertEqual a b) (if (eq a b) True False))
