;;; -*- lexical-binding: t; mode: scheme; -*-
;;; term-lisp standard prelude

;; Booleans
(datatype Bool (True) (False))
(define true True)
(define false False)

(define (if (True) a b) a)
(define (if (False) a b) b)
(define (not (True)) (False))
(define (not (False)) (True))
;; `and' and `or' decide one position in the pattern and pass the
;; other through instead of spelling the truth table out: four
;; clauses become two.  A clause that repeated a constructor would
;; spell two positions reaching one hash-consed node, which the
;; locality trial does not report (only a cut reaching outside the
;; redex is not local), and the decided form stays because it is the
;; smaller table.
(define (and (True) b) b)
(define (and (False) a) (False))
(define (or (True) a) (True))
(define (or (False) b) b)

;; Pairs
(datatype Pair (Pair a b))
(define (cons a b) (Pair a b))
(define (car (Pair a b)) a)
(define (cdr (Pair a b)) b)

;; Propositional types (Curry-Howard): `Void' is false, `Either' is
;; disjunction, `Pair' above is conjunction, `->' is implication and
;; `Unit' (below) is truth.  `absurd' is the primitive that eliminates
;; `Void'; it is unreachable, because `Void' has no constructors.
(datatype Void)
(datatype Either (Left a) (Right b))
;; Propositional equality, the Curry-Howard reading of `x = y'.  `Eq a x
;; y' is inhabited exactly when `x' and `y' are the same value of type
;; `a': `Refl' returns at `x' twice, so unifying its result with `Eq a x
;; y' binds `x' once and then demands the two occurrences agree.  The
;; index is a value rather than a type -- `Zero' and `(Succ Zero)' are
;; the kind-level spellings of the two naturals, which is why they take
;; the universe `Nat' where `Nat' itself takes `*' -- so `(Eq Nat Zero
;; (Succ Zero))' is well-kinded and yet admits no value at all.
;;
;; The parameters are annotated, and the annotations are what make the
;; kind depend: `x' and `y' are taken out of `a', so the three arguments
;; to `Eq' are no longer free to be judged one at a time.  Without them
;; `Eq : k1 -> k2 -> k3 -> *' has three independent kind variables, and
;; `Eq Nat Int Zero' answers `Nat', `*' and `Nat' -- each consistent, and
;; nothing relating them.  `(x : (univ a))' relates them, and the kind
;; error for `Int' is then not a special case but the ordinary failure
;; of `*' to be `Nat'.
(datatype (Eq (a : *) (x : (univ a)) (y : (univ a))) (Refl : (Eq a x x)))

;; Symmetry and transitivity follow from the same fact, with no eliminator
;; to write: matching a proof against `Refl' refines the index to the
;; reflexive case, which is precisely when the result type holds.  `Refl'
;; is `Eq's only constructor, so one clause settles each.
(: sym (-> (a : *) (x : a) (y : a) (Eq a x y) (Eq a y x)))
(define (sym Refl) Refl)
(: trans (-> (a : *) (x : a) (y : a) (z : a)
             (Eq a x y) (Eq a y z) (Eq a x z)))
(define (trans Refl Refl) Refl)

;; Peano naturals
(datatype Nat (Zero) (Succ Nat))
(define zero Zero)
(define one (Succ Zero))
(define two (Succ (Succ Zero)))
(define (plus Zero b) b)
(define (plus (Succ a) b) (Succ (plus a b)))

;; Indexed families (Stage 1).  A constructor written `: RESULT'
;; declares its own result type, so the index is part of the type
;; instead of something the caller has to keep straight.  Both families
;; are kinded against `Nat', which is what makes `Vec a String' a kind
;; error at the declaration rather than a case nobody remembered to
;; rule out.  Constructor names avoid `Nil'/`Cons', which `List' above
;; already owns: constructors share one namespace.
(datatype (Vec a n)
  (VNil : (Vec a Zero))
  (VCons a (Vec a n) : (Vec a (Succ n))))
(datatype (Fin n)
  (FZ : (Fin (Succ n)))
  (FS (Fin n) : (Fin (Succ n))))

;; Vec arithmetic over those indices.  The codomain's index is the
;; type-level `plus' of the two argument indices, so checking a clause
;; reduces a type: `(plus Zero m)' to `m' for the nil case,
;; `(plus (Succ n) m)' to `(Succ (plus n m))' for the cons case.  The
;; clauses are type-readable like `plus''s own, so the type layer can
;; unfold `vappend' inside a type as well.
(: vappend (-> (a : *) (n : Nat) (m : Nat)
               (xs : (Vec a n)) (ys : (Vec a m))
               (Vec a (plus n m))))
(define (vappend VNil ys) ys)
(define (vappend (VCons x xs) ys) (VCons x (vappend xs ys)))

;; Operators from the hlisp reference implementation.  Equality, exclusive
;; or and the null test are ordinary definitions; division (`/') and the
;; transcendental functions (`sin', `cos', `tan', `exp', `log', `sqrt')
;; are primitives.
(define (= a b) (eq a b))
(define (xor (True) (False)) (True))
(define (xor (False) (True)) (True))
(define (xor a b) (False))
(define (null? a) (eq a Nil))

;; Higher-order: apply a passed function to one argument
(define (map a (:lambda fun)) (fun a))

;; Monads (phase B: explicit dictionaries)

(datatype MonadDict (MonadDict tb tr tf))
(datatype Maybe (Nothing) (Just a))
(datatype List (Nil) (Cons a (List a)))

(define (monad-return (MonadDict bind return fmap) v) (return v))
(define (monad-bind (MonadDict bind return fmap) m k) (bind m k))
(define (monad-fmap (MonadDict bind return fmap) f m) (fmap f m))

;; Maybe instance
(define (maybe-return v) (Just v))
(define (maybe-bind Nothing k) Nothing)
(define (maybe-bind (Just v) k) (k v))
(define (maybe-fmap f Nothing) Nothing)
(define (maybe-fmap f (Just v)) (Just (f v)))
(define MaybeDict (MonadDict maybe-bind maybe-return maybe-fmap))

;; List instance
(define (list-return v) (Cons v Nil))
(define (list-append Nil ys) ys)
(define (list-append (Cons x xs) ys) (Cons x (list-append xs ys)))
(define (list-bind Nil k) Nil)
(define (list-bind (Cons x xs) k) (list-append (k x) (list-bind xs k)))
(define (list-fmap f Nil) Nil)
(define (list-fmap f (Cons x xs)) (Cons (f x) (list-fmap f xs)))
(define ListDict (MonadDict list-bind list-return list-fmap))

;; State instance: a computation is a function s -> (Pair a s)
(datatype Unit (Unit))
(define (state-return v) (lambda (s) (Pair v s)))
;; A State computation may hold a suspended effect in the lazy value field
;; of an intermediate `Pair' (e.g. `(print v)' from `io-print').  Bind must
;; force that value to WHNF before running the continuation, or a discarded
;; field would drop the effect.  `seq' is strict because builtin arguments
;; are forced by the driver.
(define (state-bind-step (Pair a s2) k) (seq a ((k a) s2)))
(define (state-bind m k) (lambda (s) (state-bind-step (m s) k)))
(define (state-fmap-step (Pair a s2) f) (Pair (f a) s2))
(define (state-fmap f m) (lambda (s) (state-fmap-step (m s) f)))
(define StateDict (MonadDict state-bind state-return state-fmap))
(define (state-get) (lambda (s) (Pair s s)))
(define (state-put v) (lambda (s) (Pair Unit v)))
(define run-state (lambda (m) m))

;; Reader instance: a computation is a function r -> a
(define (reader-return v) (lambda (r) v))
(define (reader-bind m k) (lambda (r) ((k (m r)) r)))
(define (reader-fmap f m) (lambda (r) (f (m r))))
(define ReaderDict (MonadDict reader-bind reader-return reader-fmap))
(define (reader-ask) (lambda (r) r))
(define run-reader (lambda (m) m))

;; IO: a computation is a State action over the world, the standard
;; input TextReader.  `print' and `read-line' are primitives backed by
;; termlisp-io.el; the definitions below lift them into the State
;; monad, so `do' with `StateDict' sequences them.
(define io-world (stdin))
(define (io-read-line) (lambda (w) (Pair (read-line) w)))
(define (io-print v) (lambda (w) (Pair (print v) w)))
(define (run-io m) (m io-world))

;; Type classes (Plan 4: dictionary-passing elaboration)
;;
;; A dictionary is one record per class.  The generic methods below take
;; the dictionary as an extra first argument; the elaborator inserts it
;; automatically at each overloaded call site.  The `monad-*' accessors
;; above keep working unchanged (they receive the dictionary explicitly).

(datatype FunctorDict (FunctorDict fmap))
(datatype ApplicativeDict (ApplicativeDict pure ap lift))

(class Functor (f) nil
  (fmap ((-> a b) -> (f a) -> (f b))))
(class Applicative (f) nil
  (pure (a -> (f a)))
  (ap ((f (-> a b)) -> (f a) -> (f b)))
  (lift-a2 ((a -> b -> c) -> (f a) -> (f b) -> (f c))))
(class Monad (m) nil
  (bind ((m a) -> (-> a (m b)) -> (m b)))
  (return (a -> (m a))))

(define (fmap (FunctorDict impl) g x) (impl g x))
(define (bind (MonadDict b r f) m k) (b m k))
(define (return (MonadDict b r f) x) (r x))
(define (pure (ApplicativeDict p a l) x) (p x))
(define (ap (ApplicativeDict p a l) mf mx) (a mf mx))
(define (lift-a2 (ApplicativeDict p a l) f mx my) (l f mx my))

(define FunctorMaybeDict (FunctorDict maybe-fmap))
(define FunctorListDict (FunctorDict list-fmap))
(define FunctorStateDict (FunctorDict state-fmap))
(define FunctorReaderDict (FunctorDict reader-fmap))

;; Applicative instance implementations
(define (maybe-pure x) (Just x))
(define (maybe-ap Nothing _) Nothing)
(define (maybe-ap (Just f) Nothing) Nothing)
(define (maybe-ap (Just f) (Just x)) (Just (f x)))

(define (list-pure x) (Cons x Nil))
(define (list-ap Nil _) Nil)
(define (list-ap (Cons f fs) xs)
  (list-append (list-fmap f xs) (list-ap fs xs)))

(define (state-pure v) (lambda (s) (Pair v s)))
(define (state-ap mf mx) (lambda (s) (state-ap-run (mf s) mx)))
(define (state-ap-run (Pair f s1) mx) (state-ap-run2 f (mx s1)))
(define (state-ap-run2 f (Pair x s2)) (Pair (f x) s2))

(define (reader-pure v) (lambda (r) v))
(define (reader-ap mf mx) (lambda (r) ((mf r) (mx r))))

;; The lift implementations call the binary function on both arguments
;; at once.  A termlisp closure would answer a partial application,
;; but a builtin like `+' has none -- `(+ x)' is elisp's unary `+' --
;; and one call keeps both kinds of function value working.
(define (maybe-lift-a2 f mf mx)
  (maybe-ap (maybe-fmap (lambda (x) (lambda (y) (f x y))) mf) mx))
(define (list-lift-a2 f mf mx)
  (list-ap (list-fmap (lambda (x) (lambda (y) (f x y))) mf) mx))
;; The first lift that carries its signature (the ziplist lift below is
;; the second).  Loaded as part of the
;; whole file, this body's inferred scheme loses the state threading
;; -- `mx' comes out unconstrained and the result `s -> ?' carries no
;; Pair -- though the same body submitted on its own infers soundly.
;; The signature states the threading the body implements.
(: state-lift-a2 (-> (a : *) (b : *) (c : *) (s : *) (s1 : *) (s2 : *)
                     (f : (-> a (-> b c)))
                     (mf : (-> s (Pair a s1)))
                     (mx : (-> s1 (Pair b s2)))
                     (-> s (Pair c s2))))
(define (state-lift-a2 f mf mx)
  (state-ap (state-fmap (lambda (x) (lambda (y) (f x y))) mf) mx))
(define (reader-lift-a2 f mf mx)
  (reader-ap (reader-fmap (lambda (x) (lambda (y) (f x y))) mf) mx))

(define ApplicativeMaybeDict (ApplicativeDict maybe-pure maybe-ap maybe-lift-a2))
(define ApplicativeListDict (ApplicativeDict list-pure list-ap list-lift-a2))
(define ApplicativeStateDict (ApplicativeDict state-pure state-ap state-lift-a2))
(define ApplicativeReaderDict (ApplicativeDict reader-pure reader-ap reader-lift-a2))

(instance (Functor Maybe) FunctorMaybeDict)
(instance (Functor List) FunctorListDict)
(instance (Functor State) FunctorStateDict)
(instance (Functor Reader) FunctorReaderDict)
(instance (Applicative Maybe) ApplicativeMaybeDict)
(instance (Applicative List) ApplicativeListDict)
(instance (Applicative State) ApplicativeStateDict)
(instance (Applicative Reader) ApplicativeReaderDict)
(instance (Monad Maybe) MaybeDict)
(instance (Monad List) ListDict)
(instance (Monad State) StateDict)
(instance (Monad Reader) ReaderDict)

;; Numeric type class: overloaded arithmetic, resolved by the operand type.
(datatype NumDict (NumDict num-add num-sub num-mul))
(class Num (a) nil
  (num-add (a -> a -> a))
  (num-sub (a -> a -> a))
  (num-mul (a -> a -> a)))
(define (num-add (NumDict add sub mul) a b) (add a b))
(define (num-sub (NumDict add sub mul) a b) (sub a b))
(define (num-mul (NumDict add sub mul) a b) (mul a b))
(define (int-num-add a b) (+ a b))
(define (int-num-sub a b) (- a b))
(define (int-num-mul a b) (* a b))
(define IntNumDict (NumDict int-num-add int-num-sub int-num-mul))
(define (double-num-add a b) (+ a b))
(define (double-num-sub a b) (- a b))
(define (double-num-mul a b) (* a b))
(define DoubleNumDict (NumDict double-num-add double-num-sub double-num-mul))
(instance (Num Int) IntNumDict)
(instance (Num DoubleFloat) DoubleNumDict)

;; List library
(define (head (Cons x xs)) x)
(define (tail (Cons x xs)) xs)
(define (append Nil ys) ys)
(define (append (Cons x xs) ys) (Cons x (append xs ys)))
(define (map-list f Nil) Nil)
(define (map-list f (Cons x xs)) (Cons (f x) (map-list f xs)))
(define (filter f Nil) Nil)
(define (filter f (Cons x xs)) (if (f x) (Cons x (filter f xs)) (filter f xs)))
(define (foldl f z Nil) z)
(define (foldl f z (Cons x xs)) (foldl f (f z x) xs))
(define (reverse-acc Nil acc) acc)
(define (reverse-acc (Cons x xs) acc) (reverse-acc xs (Cons x acc)))
(define (reverse l) (reverse-acc l Nil))
(define (sort-insert x Nil) (Cons x Nil))
(define (sort-insert x (Cons y ys))
  (if (< x y) (Cons x (Cons y ys)) (Cons y (sort-insert x ys))))
(define (sort Nil) Nil)
(define (sort (Cons x xs)) (sort-insert x (sort xs)))

;; The categorical tower: Monoid, Foldable, Traversable.  Monoid and
;; Traversable keep their dictionaries explicit, like the `monad-*'
;; accessors above: a `mempty' is a value rather than a function, and
;; `traverse' cannot be a class because a method scheme may only apply
;; its own class parameters -- an effect variable standing in argument
;; position parses as a rigid constructor, and the call site then
;; refuses every dictionary.  Foldable is a class: its scheme applies
;; only the class parameter itself.

(define (identity x) x)

;; Monoid: the identity is a value in the record, so `mempty' takes
;; the dictionary and nothing else.
(datatype MonoidDict (MonoidDict mempty mappend))
(define (mempty (MonoidDict e app)) e)
(define (mappend (MonoidDict e app) x y) (app x y))
(define (mconcat (MonoidDict e app) xs) (foldl app e xs))

;; Strings concatenate by `string-join' over a two-element list --
;; `string-append' itself is elisp's, and the prelude redefines what
;; it can spell.
(: string-append (-> String String String))
(define (string-append x y) (string-join (Cons x (Cons y Nil))))

(define MonoidListDict (MonoidDict Nil list-append))
(define MonoidIntDict (MonoidDict 0 +))
(define MonoidStringDict (MonoidDict "" string-append))

;; Endo: the monoid of endomorphisms under composition.  The wrapped
;; function is the record's value, so `run-endo' applies it and
;; `endo-mappend' composes right-to-left: the second argument runs
;; first.
(datatype Endo (Endo (-> a a)))
(define (run-endo (Endo f) x) (f x))
(define (endo-mappend (Endo f) (Endo g)) (Endo (lambda (x) (f (g x)))))
(define MonoidEndoDict (MonoidDict (Endo identity) endo-mappend))

;; Foldable: the class turns one structure's fold into every
;; structure-generic verb -- `to-list', `length' and `fold-map' are
;; three lines each over `foldr'.
(datatype FoldableDict (FoldableDict foldr))
(class Foldable (t) nil
  (foldr ((-> a b b) -> b -> (t a) -> b)))
(define (foldr (FoldableDict fo) f z t) (fo f z t))
(define (list-foldr f z Nil) z)
(define (list-foldr f z (Cons x xs)) (f x (list-foldr f z xs)))
(define (maybe-foldr f z Nothing) z)
(define (maybe-foldr f z (Just v)) (f v z))
(define FoldableListDict (FoldableDict list-foldr))
(define FoldableMaybeDict (FoldableDict maybe-foldr))
(instance (Foldable List) FoldableListDict)
(instance (Foldable Maybe) FoldableMaybeDict)
(define (to-list t) (foldr (lambda (x acc) (Cons x acc)) Nil t))
(define (length t) (foldr (lambda (_ acc) (+ acc 1)) 0 t))
(define (fold-map (MonoidDict e app) f t)
  (foldr (lambda (it acc) (app (f it) acc)) e t))

;; Traversable, dictionary-passing: the traversable's walk and the
;; effect's composition are both passed in, `monad-bind'-style.  The
;; applicative dictionary's `lift' field is the primitive traversal
;; composes through -- a destructured field is monomorphic within one
;; definition, and `ap' alone cannot spell the right fold.  Every
;; function crossing a field boundary is a plain binary lambda; the
;; lift implementations uncurry them.
(datatype TraversableDict (TraversableDict tv tm))
(define (traverse (TraversableDict tr mp) app g t) (tr app g t))
(define (mapm (TraversableDict tr mp) md g t) (mp md g t))
(define (list-traverse (ApplicativeDict p ap l) g Nil) (p Nil))
(define (list-traverse (ApplicativeDict p ap l) g (Cons x xs))
  (l (lambda (y zs) (Cons y zs)) (g x)
     (list-traverse (ApplicativeDict p ap l) g xs)))
(define (maybe-traverse (ApplicativeDict p ap l) g Nothing) (p Nothing))
(define (maybe-traverse (ApplicativeDict p ap l) g (Just v))
  (l (lambda (y mz) (Just y)) (g v) (p Nothing)))
(define (list-mapm (MonadDict b r f) g Nil) (r Nil))
(define (list-mapm (MonadDict b r f) g (Cons x xs))
  (list-mapm-bind (MonadDict b r f) g x
                  (list-mapm (MonadDict b r f) g xs)))
(define (list-mapm-bind (MonadDict b r f) g x acc)
  (b (g x) (lambda (y) (f (lambda (zs) (Cons y zs)) acc))))
(define (maybe-mapm (MonadDict b r f) g Nothing) (r Nothing))
(define (maybe-mapm (MonadDict b r f) g (Just v))
  (b (g v) (lambda (x) (r (Just x)))))
(define TraversableListDict (TraversableDict list-traverse list-mapm))
(define TraversableMaybeDict (TraversableDict maybe-traverse maybe-mapm))
(define (sequence-a td app t) (traverse td app (lambda (x) x) t))
(define (sequence td md t) (mapm td md (lambda (x) x) t))

;; Reader's two missing verbs, in the raw `reader-fmap' style its
;; transparent function type lives in.
(define (asks f) (reader-fmap f (reader-ask)))
(define (local f m) (lambda (r) (m (f r))))

;; Ziplist: the applicative that zips.  `cats' wraps a list in
;; `cats-data-ziplist', `pure' delivers a one-element ziplist, and
;; `ap' pairs the two sides element by element, truncating at the
;; shortest -- eager lists carry no `repeat' to stand for the lawful
;; identity, so the identity law holds on one-element ziplists and
;; nowhere else.  `cats' gives the type Functor, Applicative and
;; Foldable instances; this does the same, over the wrapped list, and
;; adds the Traversable pair cats does not ship.
(datatype Ziplist (Ziplist (List a)))
(define (ziplist-pure v) (Ziplist (Cons v Nil)))
(define (ziplist-fmap f (Ziplist xs)) (Ziplist (list-fmap f xs)))
(define (ziplist-ap (Ziplist fs) (Ziplist xs))
  (Ziplist (ziplist-ap-step fs xs)))
(define (ziplist-ap-step Nil xs) Nil)
(define (ziplist-ap-step (Cons f fs) Nil) Nil)
(define (ziplist-ap-step (Cons f fs) (Cons x xs))
  (Cons (f x) (ziplist-ap-step fs xs)))
;; The second lift that carries its signature.  Loaded as part of the
;; whole file, this body's inferred scheme loses the ziplist threading
;; -- `mx' and the result come out at unconstrained element types --
;; though the same body submitted on its own infers soundly, which is
;; the divergence `state-lift-a2' above documents.  The signature
;; states the threading the body implements.
(: ziplist-lift-a2 (-> (a : *) (b : *) (c : *)
                       (f : (-> a (-> b c)))
                       (mf : (Ziplist a))
                       (mx : (Ziplist b))
                       (Ziplist c)))
(define (ziplist-lift-a2 f mf mx)
  (ziplist-ap (ziplist-fmap (lambda (x) (lambda (y) (f x y))) mf) mx))
(define (ziplist-foldr f z (Ziplist xs)) (list-foldr f z xs))
;; The Traversable pair, past what cats ships.  The walk mirrors
;; `list-traverse'/`list-mapm' one level down, `ziplist-ap' style:
;; the entry point opens the ziplist and the `-list' workers rebuild
;; the wrapped list under the effect, reaching for `ziplist-cons'
;; when a combining lambda has only the wrapped tail in hand.  The
;; opening is not only style: a nested `(Ziplist (Cons x xs))'
;; pattern would hand the kind reader a `List' where Ziplist's
;; parameter asks for a `*', and the rule would go undecided rather
;; than violated.
(define (ziplist-cons x (Ziplist xs)) (Ziplist (Cons x xs)))
(define (ziplist-traverse (ApplicativeDict p ap l) g (Ziplist xs))
  (ziplist-traverse-list (ApplicativeDict p ap l) g xs))
(define (ziplist-traverse-list (ApplicativeDict p ap l) g Nil)
  (p (Ziplist Nil)))
(define (ziplist-traverse-list (ApplicativeDict p ap l) g (Cons x xs))
  (l (lambda (y zs) (ziplist-cons y zs)) (g x)
     (ziplist-traverse-list (ApplicativeDict p ap l) g xs)))
(define (ziplist-mapm (MonadDict b r f) g (Ziplist xs))
  (ziplist-mapm-list (MonadDict b r f) g xs))
(define (ziplist-mapm-list (MonadDict b r f) g Nil)
  (r (Ziplist Nil)))
(define (ziplist-mapm-list (MonadDict b r f) g (Cons x xs))
  (ziplist-mapm-bind (MonadDict b r f) g x
                     (ziplist-mapm-list (MonadDict b r f) g xs)))
(define (ziplist-mapm-bind (MonadDict b r f) g x acc)
  (b (g x) (lambda (y) (f (lambda (zs) (ziplist-cons y zs)) acc))))
(define FunctorZiplistDict (FunctorDict ziplist-fmap))
(define ApplicativeZiplistDict (ApplicativeDict ziplist-pure ziplist-ap ziplist-lift-a2))
(define FoldableZiplistDict (FoldableDict ziplist-foldr))
(define TraversableZiplistDict (TraversableDict ziplist-traverse ziplist-mapm))
(instance (Functor Ziplist) FunctorZiplistDict)
(instance (Applicative Ziplist) ApplicativeZiplistDict)
(instance (Foldable Ziplist) FoldableZiplistDict)

;; Arithmetic.  The primitives carry the operator language the
;; interpreter reaches for directly: `quo' truncates toward zero,
;; `mod' floors, `cl-gcd' is the gcd, `^' exponentiates, `zero?'
;; `even?' `odd?' test a number, and `floor' `ceiling' `round' turn a
;; float into an integer.  The rest of the library is written here
;; over them, and both division families get their partner: `quo'
;; pairs with `rem' (cutting toward zero -- Aldor's and C's) and
;; `mod' with `div' (flooring -- Scheme's).  Each pair satisfies
;; a = q * b + r for every sign of a and b; the two families give the
;; same q exactly when a/b does not come out negative.  `gcd'/`lcm'
;; are spelled over `cl-gcd', the name the Aldor operator table
;; lowers to.

(define (abs n) (if (< n 0) (- n) n))
(define (signum n) (if (< n 0) (- 1) (if (> n 0) 1 0)))
(define (min a b) (if (< a b) a b))
(define (max a b) (if (> a b) a b))
(define (positive? n) (> n 0))
(define (negative? n) (< n 0))
(define (square n) (* n n))
(define (rem a b) (- a (* (quo a b) b)))
(define (div a b) (/ (- a (mod a b)) b))
(define (gcd a b) (cl-gcd a b))
(define (lcm a b) (if (or (eq a 0) (eq b 0)) 0 (abs (/ (* a b) (gcd a b)))))
(define (sum xs) (foldl + 0 xs))
(define (product xs) (foldl * 1 xs))

;; Assertions
(define (assertEqual a b) (if (eq a b) True False))
